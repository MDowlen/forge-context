# Core state
FORGE_CONTEXT_STATE_DIR=.forge-context

# Embeddings: hash | sentence-transformers | openai
FORGE_EMBEDDING_PROVIDER=hash
FORGE_EMBEDDING_MODEL=
FORGE_EMBEDDING_DIMENSIONS=256

# OpenAI embeddings (only when provider=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Qdrant backend
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=forge_context
